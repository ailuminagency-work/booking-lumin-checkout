# Public staging values only. Copy to .env.staging and replace every placeholder.
# Never put a service-role key or provider secret in a Vite VITE_* variable.
VITE_RUNTIME_ENV=staging
VITE_RUNTIME_MODE=supabase
VITE_API_ORIGIN=https://booking-lumin-api-staging.onrender.com
VITE_FLOW_API_URL=https://booking-lumin-api-staging.onrender.com
VITE_SUPABASE_URL=https://replace-with-staging-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key
VITE_TENANT_ID=replace-with-staging-tenant-uuid
VITE_FLOW_LOCAL_HARNESS=false
VITE_MODE_OWNER_LOCAL_HARNESS=false
VITE_BASE_PATH=/
